# Analytics
# Your PostHog project API key (public key, safe to use client-side)
NUXT_PUBLIC_POSTHOG_KEY=

# The PostHog host URL (usually https://app.posthog.com or your self-hosted instance)
NUXT_PUBLIC_POSTHOG_HOST=

# Site
# The public URL of this site (no trailing slash), used for canonical URLs and OG tags
NUXT_PUBLIC_SITE_URL=
